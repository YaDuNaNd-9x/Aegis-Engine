
# AEGIS ENGINE CONFIGURATION

APP_NAME=Aegis Engine
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true

# Backend
HOST=127.0.0.1
PORT=8000

# Local LLM
OLLAMA_BASE_URL=http://localhost:11434
FAST_MODEL=qwen2.5:3b
REASONING_MODEL=qwen2.5:7b
EMBEDDING_MODEL=nomic-embed-text

# Database
DATABASE_URL=sqlite:///./storage/aegis.db

# Vector Database
CHROMA_PERSIST_DIRECTORY=./storage/chroma

# File Storage
DOCUMENT_STORAGE=./data/documents
UPLOAD_STORAGE=./data/uploads
REPORT_STORAGE=./storage/reports

# Security
ALLOW_EXTERNAL_NETWORK=false
MAX_UPLOAD_SIZE_MB=25
MAX_EXECUTION_TIME=10
